{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "sortPackageJson": false,
  "ignorePatterns": [
    "**/node_modules/**",
    "**/.next/**",
    "**/.turbo/**",
    "**/lib/**",
    "**/*.res.mjs",
    "**/*.gen.tsx",
    "**/next-env.d.ts",
    "**/*.tsbuildinfo",
    "test-results/**",
    "playwright-report/**",
    "pnpm-lock.yaml",
    "drizzle/meta/**",
    "**/*.res",
    "**/*.resi",
    "apps/web/src/app/globals.css"
  ]
}
